<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidVisualBoostPackage">
    <Menus>
      <Menu guid="guidVisualBoostCommandSet" id="VisualBoostActionPopup" priority="0x0100" type="Context">
        <Strings><ButtonText>VisualBoost 코드 도구</ButtonText></Strings>
      </Menu>
      <Menu guid="guidVisualBoostCommandSet" id="VisualBoostDeclarationPopup" priority="0x0200" type="Menu">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostActionPopupGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings><ButtonText>선언 생성</ButtonText></Strings>
      </Menu>
      <!-- C++ 문서에서만 보입니다(CodeContextMenuCommand가 표시 여부를 정함). -->
      <Menu guid="guidVisualBoostCommandSet" id="VisualBoostCodeMenu" priority="0x0100" type="Menu">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostCodeContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings><ButtonText>Visual Boost</ButtonText></Strings>
      </Menu>
      <Menu guid="guidVisualBoostCommandSet" id="VisualBoostSubmenu" priority="0x0100" type="Menu">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostToolsGroup" />
        <Strings>
          <ButtonText>Visual Boost</ButtonText>
        </Strings>
      </Menu>
    </Menus>
    <Groups>
      <Group guid="guidVisualBoostCommandSet" id="VisualBoostActionPopupGroup" priority="0x0100">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostActionPopup" />
      </Group>
      <Group guid="guidVisualBoostCommandSet" id="VisualBoostDeclarationPopupGroup" priority="0x0100">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostDeclarationPopup" />
      </Group>
      <Group guid="guidVisualBoostCommandSet" id="VisualBoostCodeContextGroup" priority="0x0800">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
      <!-- 편집기 문맥 메뉴 > Visual Boost: 커서 위치의 이동 명령을 코드 도구 위에 둡니다. -->
      <Group guid="guidVisualBoostCommandSet" id="VisualBoostNavigationContextGroup" priority="0x0080">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostCodeMenu" />
      </Group>
      <Group guid="guidVisualBoostCommandSet" id="VisualBoostGenerationContextGroup" priority="0x0100">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostCodeMenu" />
      </Group>
      <Group guid="guidVisualBoostCommandSet" id="VisualBoostToolsGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <!-- Tools > Visual Boost는 찾기 · 코드 이동 · 코드 도구 · 설정 순서로 구분선을 둡니다. -->
      <Group guid="guidVisualBoostCommandSet" id="VisualBoostCommandGroup" priority="0x0100">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostSubmenu" />
      </Group>
      <Group guid="guidVisualBoostCommandSet" id="VisualBoostNavigationGroup" priority="0x0140">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostSubmenu" />
      </Group>
      <Group guid="guidVisualBoostCommandSet" id="VisualBoostEditGroup" priority="0x0180">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostSubmenu" />
      </Group>
      <Group guid="guidVisualBoostCommandSet" id="VisualBoostSettingsGroup" priority="0x0200">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostSubmenu" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidVisualBoostCommandSet" id="VisualBoostActionItemStart" priority="0x0100" type="Button">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostActionPopupGroup" />
        <CommandFlag>DynamicItemStart</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings><ButtonText>코드 도구</ButtonText></Strings>
      </Button>
      <Button guid="guidVisualBoostCommandSet" id="VisualBoostDeclarationItemStart" priority="0x0100" type="Button">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostDeclarationPopupGroup" />
        <CommandFlag>DynamicItemStart</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings><ButtonText>선언 접근 수준</ButtonText></Strings>
      </Button>
      <Button guid="guidVisualBoostCommandSet" id="GenerateFunctionCommand" priority="0x01C0" type="Button">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostEditGroup" />
        <Strings><ButtonText>현재 코드 도구...</ButtonText><CanonicalName>VisualBoost.GenerateFunction</CanonicalName><LocCanonicalName>VisualBoost.현재코드도구</LocCanonicalName></Strings>
      </Button>
      <Button guid="guidVisualBoostCommandSet" id="OpenDocumentMembersCommand" priority="0x0195" type="Button">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostCommandGroup" />
        <Strings>
          <ButtonText>문서 함수 탐색...</ButtonText>
          <CanonicalName>VisualBoost.OpenDocumentMembers</CanonicalName>
          <LocCanonicalName>VisualBoost.문서함수탐색</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidVisualBoostCommandSet" id="GoToDefinitionCommand" priority="0x0110" type="Button">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostNavigationGroup" />
        <Strings>
          <ButtonText>정의로 이동</ButtonText>
          <CanonicalName>VisualBoost.GoToDefinition</CanonicalName>
          <LocCanonicalName>VisualBoost.정의로이동</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidVisualBoostCommandSet" id="FindReferencesCommand" priority="0x0120" type="Button">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostNavigationGroup" />
        <Strings>
          <ButtonText>참조 찾기</ButtonText>
          <CanonicalName>VisualBoost.FindReferences</CanonicalName>
          <LocCanonicalName>VisualBoost.참조찾기</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidVisualBoostCommandSet" id="ShowReferencesWindowCommand" priority="0x0125" type="Button">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostNavigationGroup" />
        <Strings>
          <ButtonText>참조 결과 창</ButtonText>
          <CanonicalName>VisualBoost.ShowReferencesWindow</CanonicalName>
          <LocCanonicalName>VisualBoost.참조결과창</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidVisualBoostCommandSet" id="SwitchHeaderSourceCommand" priority="0x0130" type="Button">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostNavigationGroup" />
        <Strings>
          <ButtonText>헤더/구현 파일 전환</ButtonText>
          <CanonicalName>VisualBoost.SwitchHeaderSource</CanonicalName>
          <LocCanonicalName>VisualBoost.헤더구현파일전환</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidVisualBoostCommandSet" id="OpenOptionsCommand" priority="0x0200" type="Button">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostSettingsGroup" />
        <Strings>
          <ButtonText>옵션...</ButtonText>
          <CanonicalName>VisualBoost.OpenOptions</CanonicalName>
          <LocCanonicalName>VisualBoost.옵션</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidVisualBoostCommandSet" id="OpenFileSearchCommand" priority="0x0180" type="Button">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostCommandGroup" />
        <Strings>
          <ButtonText>파일 탐색...</ButtonText>
          <CanonicalName>VisualBoost.OpenFileSearch</CanonicalName>
          <LocCanonicalName>VisualBoost.파일탐색</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidVisualBoostCommandSet" id="OpenSymbolSearchCommand" priority="0x0190" type="Button">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostCommandGroup" />
        <Strings>
          <ButtonText>심볼 탐색...</ButtonText>
          <CanonicalName>VisualBoost.OpenSymbolSearch</CanonicalName>
          <LocCanonicalName>VisualBoost.심볼탐색</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidVisualBoostCommandSet" id="ShowIndexStatusCommand" priority="0x0300" type="Button">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostSettingsGroup" />
        <Strings>
          <ButtonText>인덱스 상태...</ButtonText>
          <CanonicalName>VisualBoost.ShowIndexStatus</CanonicalName>
          <LocCanonicalName>VisualBoost.인덱스상태</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidVisualBoostCommandSet" id="RebuildIndexCommand" priority="0x0310" type="Button">
        <Parent guid="guidVisualBoostCommandSet" id="VisualBoostSettingsGroup" />
        <Strings>
          <ButtonText>인덱스 다시 만들기...</ButtonText>
          <CanonicalName>VisualBoost.RebuildIndex</CanonicalName>
          <LocCanonicalName>VisualBoost.인덱스다시만들기</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <!-- 편집기 문맥 메뉴에서도 단축키와 같은 명령을 찾을 수 있게 같은 명령을 다시 배치합니다. -->
    <CommandPlacement guid="guidVisualBoostCommandSet" id="GoToDefinitionCommand" priority="0x0100">
      <Parent guid="guidVisualBoostCommandSet" id="VisualBoostNavigationContextGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidVisualBoostCommandSet" id="FindReferencesCommand" priority="0x0110">
      <Parent guid="guidVisualBoostCommandSet" id="VisualBoostNavigationContextGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidVisualBoostCommandSet" id="SwitchHeaderSourceCommand" priority="0x0120">
      <Parent guid="guidVisualBoostCommandSet" id="VisualBoostNavigationContextGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidVisualBoostCommandSet" id="GenerateFunctionCommand" priority="0x0100">
      <Parent guid="guidVisualBoostCommandSet" id="VisualBoostGenerationContextGroup" />
    </CommandPlacement>
    <!-- 보기 > 다른 창에서도 참조 결과 창을 다시 열 수 있게 합니다. -->
    <CommandPlacement guid="guidVisualBoostCommandSet" id="ShowReferencesWindowCommand" priority="0x0100">
      <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
    </CommandPlacement>
  </CommandPlacements>
  <KeyBindings>
    <KeyBinding guid="guidVisualBoostCommandSet" id="GenerateFunctionCommand" editor="GUID_TextEditorFactory" mod1="Shift Alt" key1="Q" />
    <KeyBinding guid="guidVisualBoostCommandSet" id="OpenDocumentMembersCommand" editor="GUID_TextEditorFactory" mod1="ALT" key1="M" />
    <KeyBinding guid="guidVisualBoostCommandSet" id="SwitchHeaderSourceCommand" editor="guidVSStd97" mod1="ALT" key1="O" />
    <KeyBinding guid="guidVisualBoostCommandSet" id="OpenFileSearchCommand" editor="GUID_TextEditorFactory" mod1="Shift Alt" key1="O" />
    <KeyBinding guid="guidVisualBoostCommandSet" id="OpenSymbolSearchCommand" editor="GUID_TextEditorFactory" mod1="Shift Alt" key1="S" />
    <KeyBinding guid="guidVisualBoostCommandSet" id="GoToDefinitionCommand" editor="GUID_TextEditorFactory" mod1="ALT" key1="G" />
    <KeyBinding guid="guidVisualBoostCommandSet" id="FindReferencesCommand" editor="GUID_TextEditorFactory" mod1="Shift Alt" key1="F" />
  </KeyBindings>

