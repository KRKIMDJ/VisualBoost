<Popup x:Class="VisualBoost.DocumentNavigation.DocumentNavigationControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:VisualBoost.UI"
 xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
 x:Name="Root" Focusable="False" Placement="Relative" StaysOpen="False" AllowsTransparency="True"
 Opened="OnOpened" Closed="OnClosed">
 <Popup.Resources>
  <ui:SymbolColorConverter x:Key="SymbolColor" />
  <Style TargetType="GridViewColumnHeader">
   <Setter Property="Height" Value="25"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Padding" Value="7,0"/>
   <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.GridHeadingBackgroundKey}}"/>
   <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBorderKey}}"/>
   <Setter Property="ToolTip" Value="열 경계를 끌어 너비 비율 조절"/>
  </Style>
 </Popup.Resources>
   <Border x:Name="PopupSurface" BorderThickness="1" Padding="0" Width="720"
           Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
           BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBorderKey}}"
           TextElement.Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}" PreviewKeyDown="OnPopupKeyDown">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBox x:Name="Search" Margin="8" Padding="7,4" TextChanged="OnSearchChanged"
       ToolTip="함수 이름 검색 · 공백으로 AND 검색" AutomationProperties.Name="문서 함수 이름 검색"
       Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
     <DockPanel Grid.Row="1" Margin="9,0,9,6">
      <TextBlock Text="현재 문서의 함수 · Alt+M" Opacity="0.7"/>
      <TextBlock x:Name="OrderLabel" Text="문서 순서" HorizontalAlignment="Right" Opacity="0.65"/>
     </DockPanel>
     <ui:FittedResultsList x:Name="Results" Grid.Row="2" Height="288" BorderThickness="0"
       MouseDoubleClick="OnDoubleClick" Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}" ui:SearchPalette.Track="True"
       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
       AutomationProperties.Name="문서 함수 목록">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
       <Setter Property="Height" Value="24"/><Setter Property="Padding" Value="4,0"/>
       <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
       <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
       <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
       <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
        <Border x:Name="RowSurface" Background="Transparent">
         <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.SearchBoxBackgroundKey}}"/></Trigger>
         <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.HighlightKey}}"/>
          <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.HighlightTextKey}}"/>
         </Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
      </Style></ListView.ItemContainerStyle>
      <ListView.View><GridView AllowsColumnReorder="False">
       <GridViewColumn Header="함수" Width="510"><GridViewColumn.CellTemplate><DataTemplate>
        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ui:SearchTextHighlight.Text="{Binding Name}" ui:SearchTextHighlight.Query="{Binding Text, ElementName=Search}">
         <TextBlock.Foreground><MultiBinding Converter="{StaticResource SymbolColor}">
          <Binding Path="ColorKind"/><Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=ListViewItem}"/>
          <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ListViewItem}"/>
          <Binding Path="Background" RelativeSource="{RelativeSource AncestorType=ListView}"/>
          <Binding Path="(ui:SearchPalette.Revision)" RelativeSource="{RelativeSource AncestorType=ListView}"/>
         </MultiBinding></TextBlock.Foreground>
        </TextBlock>
       </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
       <GridViewColumn Header="종류" Width="120" DisplayMemberBinding="{Binding Kind}"/>
       <GridViewColumn Header="라인" Width="65" DisplayMemberBinding="{Binding Line}"/>
      </GridView></ListView.View>
     </ui:FittedResultsList>
     <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBorderKey}}" Padding="9,6">
      <DockPanel><TextBlock x:Name="Status" Text="분석 중…"/><TextBlock Text="↑↓ 선택   Enter 이동   Esc 닫기" HorizontalAlignment="Right" Opacity="0.65"/></DockPanel>
     </Border>
    </Grid>
   </Border>
</Popup>
