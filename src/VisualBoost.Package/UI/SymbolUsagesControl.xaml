<UserControl x:Class="VisualBoost.UI.SymbolUsagesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:VisualBoost.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ui:SearchPalette.Track="True"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             PreviewKeyDown="OnPreviewKeyDown">
  <UserControl.Resources>
    <ui:SymbolColorConverter x:Key="SymbolColorConverter" />


    <DataTemplate x:Key="CodeSegmentTemplate">
      <TextBlock Text="{Binding Text}">
        <TextBlock.Foreground>
          <MultiBinding Converter="{StaticResource SymbolColorConverter}">
            <Binding Path="Kind" />
            <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=ListViewItem}" />
            <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ListViewItem}" />
            <Binding Path="Background" RelativeSource="{RelativeSource AncestorType=UserControl}" />
            <Binding Path="(ui:SearchPalette.Revision)" RelativeSource="{RelativeSource AncestorType=UserControl}" />
          </MultiBinding>
        </TextBlock.Foreground>
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsMatch}" Value="True">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="TextDecorations" Value="Underline" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </DataTemplate>

    <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                    BorderThickness="0,0,0,1">
              <GridViewRowPresenter Content="{TemplateBinding Content}"
                  Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                  VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.SearchBoxBackgroundKey}}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Height" Value="28" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="ToolTip" Value="열 경계를 끌어 너비 비율 조절" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.GridHeadingBackgroundKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="8,5"
            Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarGradientKey}}"
            BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Text="심볼:" Opacity="0.72"
                   ToolTip="저장된 C++ 파일의 식별자 이름을 검색합니다. 주석·문자열은 제외하며 선언·정의와 같은 이름의 다른 심볼은 포함될 수 있습니다." />
        <TextBlock x:Name="SymbolText" Grid.Column="1" Margin="6,0,18,0"
                   VerticalAlignment="Center" FontWeight="Bold" MaxWidth="280" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="검색 범위" Opacity="0.72" />
          <ComboBox x:Name="ScopeSelector" Width="140" Height="24"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}"
                    ItemContainerStyle="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxItemStyleKey}}"
                    SelectedValuePath="Tag" SelectionChanged="OnScopeChanged">
            <ComboBoxItem x:Name="CurrentProjectScopeItem" Tag="CurrentProject" Content="현재 프로젝트" />
            <ComboBoxItem Tag="EntireSolution" Content="전체 솔루션" />
          </ComboBox>
        </StackPanel>
        <Button Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" x:Name="CancelSearchButton" Grid.Column="3" MinWidth="76" Padding="8,2"
                Content="검색 취소" Visibility="Collapsed" Click="OnCancelSearchClick" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <ui:FittedResultsList x:Name="ResultsList" BorderThickness="0"
                Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                ItemContainerStyle="{StaticResource ResultItemStyle}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                MouseDoubleClick="OnResultDoubleClick">
        <ListView.View>
          <GridView AllowsColumnReorder="False">
            <GridViewColumn Header="코드" Width="540">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <ItemsControl Margin="7,0" VerticalAlignment="Center" ClipToBounds="True"
                                ItemsSource="{Binding CodeSegments}"
                                ToolTip="{Binding Location.LineText}"
                                ItemTemplate="{StaticResource CodeSegmentTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="파일" Width="300">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Margin="7,0" VerticalAlignment="Center" FontWeight="Bold"
                             Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding FullPath}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="라인" Width="60" DisplayMemberBinding="{Binding Line}" />
            <GridViewColumn Header="프로젝트" Width="150">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Margin="7,0" VerticalAlignment="Center" Text="{Binding ProjectName}"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectName}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ui:FittedResultsList>

      <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center"
                  VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock x:Name="EmptyStateTitle" HorizontalAlignment="Center"
                   FontSize="14" FontWeight="SemiBold" Text="검색할 심볼을 선택하세요." />
        <TextBlock x:Name="EmptyStateDescription" Margin="0,5,0,0"
                   HorizontalAlignment="Center" Opacity="0.68"
                   Text="편집기에서 심볼을 선택한 뒤 코드 검색을 실행하세요." />
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Padding="8,4"
            Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarGradientKey}}"
            BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
            BorderThickness="0,1,0,0">
      <Grid>
        <TextBlock x:Name="StatusText" HorizontalAlignment="Left" Text="대기 중" />
        <TextBlock HorizontalAlignment="Right" Text="Enter 열기   Esc 검색 취소" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
