<UserControl x:Class="VisualBoost.UI.ReferencesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:VisualBoost.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             FontSize="12"
             PreviewKeyDown="OnPreviewKeyDown">
  <UserControl.Resources>
    <Style x:Key="RowStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="RowBorder" Background="{TemplateBinding Background}" Padding="4,0">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowBorder" Property="Background"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.SearchBoxBackgroundKey}}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowBorder" Property="Background"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 파일 머리 행: 펼침 표시 · 파일 이름 · 폴더 · 위치 수 -->
    <DataTemplate DataType="{x:Type ui:ReferenceFileRow}">
      <Grid Height="24" ToolTip="{Binding FullPath}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Glyph" Grid.Column="0" Text="{Binding Glyph}" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Background="Transparent" Cursor="Hand" />
        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,10,0" />
        <TextBlock Grid.Column="2" Text="{Binding Folder}" Opacity="0.65" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="3" Margin="8,0,4,0" Padding="6,0" CornerRadius="8" VerticalAlignment="Center"
                Background="{DynamicResource {x:Static vsshell:VsBrushes.SearchBoxBackgroundKey}}">
          <TextBlock Text="{Binding Count}" FontSize="11" />
        </Border>
      </Grid>
    </DataTemplate>

    <!-- 위치 행: (묶지 않을 때 파일) · 줄 · 코드 미리보기 · 포함 함수 -->
    <DataTemplate DataType="{x:Type ui:ReferenceLineRow}">
      <Grid MinHeight="22" ToolTip="{Binding FullPath}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Indent" Grid.Column="0" Width="18" />
        <TextBlock x:Name="FileColumn" Grid.Column="0" Width="220" Visibility="Collapsed" Margin="4,0,0,0"
                   Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Line}" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBlock Grid.Column="2" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   ui:CodeSegments.Before="{Binding Before}"
                   ui:CodeSegments.Match="{Binding Match}"
                   ui:CodeSegments.After="{Binding After}"
                   ToolTip="{Binding Code}" />
        <TextBlock x:Name="ContainerText" Grid.Column="3" Text="{Binding Container}" Opacity="0.65" MaxWidth="280" Margin="12,0,4,0"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Container}" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding ShowFile}" Value="True">
          <Setter TargetName="Indent" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="FileColumn" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Container}" Value="">
          <Setter TargetName="ContainerText" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="8,6"
            Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarGradientKey}}"
            BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="SymbolText" FontSize="13" FontWeight="SemiBold" MaxWidth="360" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock x:Name="SummaryText" Margin="10,0,0,0" Opacity="0.75" MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Column="1" MinWidth="160" MaxWidth="420" HorizontalAlignment="Stretch"
                BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="1" CornerRadius="3"
                Background="{DynamicResource {x:Static vsshell:VsBrushes.SearchBoxBackgroundKey}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="⌕" />
            <Grid Grid.Column="1">
              <TextBox x:Name="FilterBox" Padding="0,3" BorderThickness="0" Background="Transparent"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                       TextChanged="OnFilterTextChanged" />
              <TextBlock x:Name="FilterPlaceholder" VerticalAlignment="Center" Opacity="0.6" IsHitTestVisible="False"
                         Text="파일·폴더·코드·함수로 좁히기" />
            </Grid>
          </Grid>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <CheckBox Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" x:Name="GroupToggle" Content="파일별 묶기" IsChecked="True" VerticalAlignment="Center"
                    Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                    Checked="OnGroupToggled" Unchecked="OnGroupToggled" />
          <Button Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" x:Name="ExpandAllButton" Content="펼치기" Margin="10,0,0,0" Padding="8,1" ToolTip="모든 파일 펼치기" Click="OnExpandAll" />
          <Button Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" x:Name="CollapseAllButton" Content="접기" Margin="4,0,0,0" Padding="8,1" ToolTip="모든 파일 접기" Click="OnCollapseAll" />
          <ComboBox Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}"
                    ItemContainerStyle="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxItemStyleKey}}"
                    x:Name="HistoryBox" Width="200" Margin="10,0,0,0" ToolTip="최근 참조 결과"
                    SelectionChanged="OnHistorySelectionChanged" />
        </StackPanel>
      </Grid>
    </Border>

    <ListBox x:Name="ResultsList" Grid.Row="1"
             BorderThickness="0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             ItemContainerStyle="{StaticResource RowStyle}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             MouseDoubleClick="OnResultDoubleClick"
             PreviewMouseLeftButtonDown="OnResultMouseDown" />

    <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65"
               TextAlignment="Center" Text="C++ 편집기에서 참조 찾기(Shift+Alt+F)를 실행하면 결과가 여기에 표시됩니다." />

    <Border Grid.Row="2" Padding="8,3"
            Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarGradientKey}}"
            BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
            BorderThickness="0,1,0,0">
      <TextBlock Opacity="0.75" TextTrimming="CharacterEllipsis"
                 Text="Enter 열기 · Space 창에 머문 채 열기 · ←/→ 파일 접기·펼치기 · 더블클릭 열기" />
    </Border>
  </Grid>
</UserControl>
