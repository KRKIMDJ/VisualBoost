<platform:DialogWindow x:Class="VisualBoost.UI.FileSearchDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                       xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                       Title="VisualBoost 파일 탐색"
                       Width="760"
                       Height="520"
                       MinWidth="560"
                       MinHeight="360"
                       ShowInTaskbar="False"
                       Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                       PreviewKeyDown="OnPreviewKeyDown">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox x:Name="SearchBox"
             Grid.Row="0"
             Margin="0,0,0,10"
             Padding="8,6"
             FontSize="15"
             ToolTip="파일명 또는 경로를 입력하세요."
             TextChanged="OnSearchTextChanged" />

    <ListBox x:Name="ResultsList"
             Grid.Row="1"
             BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             MouseDoubleClick="OnResultDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="6,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       FontWeight="SemiBold"
                       Text="{Binding FileName}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1"
                       Margin="0,2,0,0"
                       Opacity="0.72"
                       FontSize="11"
                       Text="{Binding DirectoryPath}"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <DockPanel Grid.Row="2" Margin="0,9,0,0" LastChildFill="True">
      <TextBlock x:Name="ResultCountText" DockPanel.Dock="Right" Margin="12,0,0,0" />
      <TextBlock x:Name="HintText" Text="파일명 또는 경로를 입력하세요.  Enter: 열기  Esc: 닫기" />
    </DockPanel>
  </Grid>
</platform:DialogWindow>
