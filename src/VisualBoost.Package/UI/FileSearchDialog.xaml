<platform:DialogWindow x:Class="VisualBoost.UI.FileSearchDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
                       xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                       xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                       Title="VisualBoost 파일 탐색"
                       Width="760"
                       Height="520"
                       MinWidth="600"
                       MinHeight="380"
                       ShowInTaskbar="False"
                       WindowStartupLocation="CenterOwner"
                       Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                       PreviewKeyDown="OnPreviewKeyDown">
  <platform:DialogWindow.Resources>
    <Style x:Key="ScopeButtonStyle" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="ButtonBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ButtonBorder"
                        Property="Background"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder"
                        Property="BorderBrush"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                    BorderThickness="0,0,0,1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder"
                        Property="Background"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="HighlightedTextTemplate">
      <TextBlock Text="{Binding Text}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsMatch}" Value="True">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="TextDecorations" Value="Underline" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </DataTemplate>
  </platform:DialogWindow.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Margin="-12,-12,-12,0"
            Padding="12,12,12,8"
            Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarGradientKey}}">
      <StackPanel>
      <Border x:Name="SearchBorder"
              BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
              BorderThickness="1"
              CornerRadius="3"
              Background="{DynamicResource {x:Static vsshell:VsBrushes.SearchBoxBackgroundKey}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="34" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="15"
                     Text="⌕"
                     IsHitTestVisible="False" />

          <Grid Grid.Column="1">
            <TextBox x:Name="SearchBox"
                     Padding="0,8"
                     FontSize="15"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                     ToolTip="파일명 또는 경로를 입력하세요."
                     TextChanged="OnSearchTextChanged"
                     GotKeyboardFocus="OnSearchFocusChanged"
                     LostKeyboardFocus="OnSearchFocusChanged" />
            <TextBlock x:Name="SearchPlaceholder"
                       Margin="1,0,0,0"
                       VerticalAlignment="Center"
                       Opacity="0.62"
                       Text="파일명 또는 경로 검색"
                       IsHitTestVisible="False" />
          </Grid>

          <Button x:Name="ClearSearchButton"
                  Grid.Column="2"
                  Margin="4"
                  Padding="0"
                  FontSize="15"
                  Content="×"
                  ToolTip="검색어 지우기"
                  Click="OnClearSearchClick" />
        </Grid>
      </Border>

      <StackPanel x:Name="ScopePanel" Margin="0,8,0,0" Orientation="Horizontal">
        <RadioButton x:Name="AllScopeButton"
                     GroupName="SearchScope"
                     Tag="All"
                     Content="전체"
                     Style="{StaticResource ScopeButtonStyle}"
                     Click="OnScopeClick" />
        <RadioButton x:Name="CurrentProjectScopeButton"
                     GroupName="SearchScope"
                     Tag="CurrentProject"
                     Content="현재 프로젝트"
                     Style="{StaticResource ScopeButtonStyle}"
                     Click="OnScopeClick" />
        <RadioButton x:Name="OpenFilesScopeButton"
                     GroupName="SearchScope"
                     Tag="OpenFiles"
                     Content="열린 파일"
                     Style="{StaticResource ScopeButtonStyle}"
                     Click="OnScopeClick" />
        <RadioButton x:Name="ExternalSourcesScopeButton"
                     GroupName="SearchScope"
                     Tag="ExternalSources"
                     Content="외부 소스"
                     Style="{StaticResource ScopeButtonStyle}"
                     Click="OnScopeClick" />
      </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1"
          Margin="-12,0,-12,0"
          Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="26" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Padding="7,0,24,0"
              Background="{DynamicResource {x:Static vsshell:VsBrushes.GridHeadingBackgroundKey}}"
              BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
              BorderThickness="1,1,1,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="128" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.72" FontSize="11" Text="유형" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.72" FontSize="11" Text="파일명" />
          <TextBlock Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Opacity="0.72" FontSize="11" Text="경로" />
          <TextBlock Grid.Column="3" Margin="8,0,3,0" VerticalAlignment="Center" Opacity="0.72" FontSize="11" Text="프로젝트" />
        </Grid>
      </Border>

      <ListBox x:Name="ResultsList"
               Grid.Row="1"
               BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
               BorderThickness="1"
               Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
               ItemContainerStyle="{StaticResource ResultItemStyle}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Visible"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling"
               PreviewMouseRightButtonDown="OnResultsPreviewMouseRightButtonDown"
               ContextMenuOpening="OnResultsContextMenuOpening"
               MouseDoubleClick="OnResultDoubleClick">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="열기" Click="OnContextOpenClick" />
            <Separator />
            <MenuItem Header="전체 경로 복사" Click="OnContextCopyPathClick" />
            <MenuItem Header="탐색기에서 보기" Click="OnContextShowInExplorerClick" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid MinHeight="32" Margin="7,0" ToolTip="{Binding FullPath}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="128" />
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0"
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <Border Background="White"
                        BorderBrush="#D8D8D8"
                        BorderThickness="1"
                        CornerRadius="2"
                        Visibility="{Binding IconVisibility}">
                  <imaging:CrispImage Width="16"
                                      Height="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Moniker="{Binding IconMoniker}" />
                </Border>
                <Border Width="20"
                        Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Visibility="{Binding FallbackIconVisibility}">
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontSize="8"
                             FontWeight="SemiBold"
                             Text="{Binding IconText}" />
                </Border>
              </Grid>

              <ItemsControl Grid.Column="1"
                            VerticalAlignment="Center"
                            ClipToBounds="True"
                            ItemsSource="{Binding FileNameSegments}"
                            ItemTemplate="{StaticResource HighlightedTextTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <ItemsControl Grid.Column="2"
                            Margin="10,0"
                            VerticalAlignment="Center"
                            ClipToBounds="True"
                            Opacity="0.72"
                            ItemsSource="{Binding PathSegments}"
                            ItemTemplate="{StaticResource HighlightedTextTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <TextBlock Grid.Column="3"
                         Margin="8,0,3,0"
                         VerticalAlignment="Center"
                         Opacity="0.78"
                         FontSize="11"
                         Text="{Binding ProjectName}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel x:Name="EmptyStatePanel"
                  Grid.Row="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False">
        <TextBlock x:Name="EmptyStateTitle"
                   HorizontalAlignment="Center"
                   FontSize="15"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="EmptyStateDescription"
                   Margin="0,5,0,0"
                   HorizontalAlignment="Center"
                   Opacity="0.68" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="2"
            Margin="-12,0,-12,-12"
            Padding="12,7,12,8"
            Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarOptionsBackgroundKey}}"
            BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
            BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="True">
        <Button x:Name="CancelSearchButton"
                DockPanel.Dock="Right"
                Margin="12,-3,0,-3"
                Padding="9,2"
                Content="검색 취소"
                Visibility="Collapsed"
                Click="OnCancelSearchClick" />
        <TextBlock x:Name="KeyboardHintText"
                   DockPanel.Dock="Right"
                   Margin="14,0,0,0"
                   Opacity="0.72"
                   Text="↑↓ 선택   Enter 열기   Esc 닫기" />
        <TextBlock x:Name="StatusText" Opacity="0.78" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</platform:DialogWindow>
