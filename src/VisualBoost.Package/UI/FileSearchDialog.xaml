<platform:DialogWindow x:Class="VisualBoost.UI.FileSearchDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:ui="clr-namespace:VisualBoost.UI"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                       xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                       Title="VisualBoost 파일 탐색"
                       Width="760"
                       Height="520"
                       MinWidth="600"
                       MinHeight="380"
                       ShowInTaskbar="False"
                       WindowStartupLocation="CenterOwner"
                       Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                       PreviewKeyDown="OnPreviewKeyDown">
  <platform:DialogWindow.Resources>


    <Style x:Key="ScopeButtonStyle" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="ButtonBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ButtonBorder"
                        Property="Background"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder"
                        Property="BorderBrush"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                    BorderThickness="0,0,0,1">
              <GridViewRowPresenter Content="{TemplateBinding Content}"
                  Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                  VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.SearchBoxBackgroundKey}}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder"
                        Property="Background"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Height" Value="28" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="ToolTip" Value="열 경계를 끌어 너비 비율 조절" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.GridHeadingBackgroundKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
    </Style>

    <DataTemplate x:Key="HighlightedTextTemplate">
      <TextBlock Text="{Binding Text}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsMatch}" Value="True">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="TextDecorations" Value="Underline" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </DataTemplate>
  </platform:DialogWindow.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Margin="-12,-12,-12,0"
            Padding="12,12,12,8"
            Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarGradientKey}}">
      <StackPanel>
      <Border x:Name="SearchBorder"
              BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
              BorderThickness="1"
              CornerRadius="3"
              Background="{DynamicResource {x:Static vsshell:VsBrushes.SearchBoxBackgroundKey}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="34" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="15"
                     Text="⌕"
                     IsHitTestVisible="False" />

          <Grid Grid.Column="1">
            <TextBox x:Name="SearchBox"
                     Padding="0,8"
                     FontSize="15"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                     ToolTip="파일명 또는 경로를 입력하세요."
                     TextChanged="OnSearchTextChanged"
                     GotKeyboardFocus="OnSearchFocusChanged"
                     LostKeyboardFocus="OnSearchFocusChanged" />
            <TextBlock x:Name="SearchPlaceholder"
                       Margin="1,0,0,0"
                       VerticalAlignment="Center"
                       Opacity="0.62"
                       Text="파일명 또는 경로 검색"
                       IsHitTestVisible="False" />
          </Grid>

          <Button Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" x:Name="ClearSearchButton"
                  Grid.Column="2"
                  Margin="4"
                  Padding="0"
                  FontSize="15"
                  Content="×"
                  ToolTip="검색어 지우기"
                  Click="OnClearSearchClick" />
        </Grid>
      </Border>

      <StackPanel x:Name="ScopePanel" Margin="0,8,0,0" Orientation="Horizontal">
        <RadioButton x:Name="AllScopeButton"
                     GroupName="SearchScope"
                     Tag="All"
                     Content="전체"
                     Style="{StaticResource ScopeButtonStyle}"
                     Click="OnScopeClick" />
        <RadioButton x:Name="CurrentProjectScopeButton"
                     GroupName="SearchScope"
                     Tag="CurrentProject"
                     Content="현재 프로젝트"
                     Style="{StaticResource ScopeButtonStyle}"
                     Click="OnScopeClick" />
        <RadioButton x:Name="OpenFilesScopeButton"
                     GroupName="SearchScope"
                     Tag="OpenFiles"
                     Content="열린 파일"
                     Style="{StaticResource ScopeButtonStyle}"
                     Click="OnScopeClick" />
        <RadioButton x:Name="ExternalSourcesScopeButton"
                     GroupName="SearchScope"
                     Tag="ExternalSources"
                     Content="외부 소스"
                     Style="{StaticResource ScopeButtonStyle}"
                     Click="OnScopeClick" />
      </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1"
          Margin="-12,0,-12,0"
          Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}">
      <ui:FittedResultsList x:Name="ResultsList"
               BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
               BorderThickness="1"
               Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
               ItemContainerStyle="{StaticResource ResultItemStyle}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Visible"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling"
               PreviewMouseRightButtonDown="OnResultsPreviewMouseRightButtonDown"
               ContextMenuOpening="OnResultsContextMenuOpening"
               MouseDoubleClick="OnResultDoubleClick">
        <ListView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="열기" Click="OnContextOpenClick" />
            <Separator />
            <MenuItem Header="전체 경로 복사" Click="OnContextCopyPathClick" />
            <MenuItem Header="탐색기에서 보기" Click="OnContextShowInExplorerClick" />
          </ContextMenu>
        </ListView.ContextMenu>
        <ListView.View>
          <GridView AllowsColumnReorder="False">
            <GridViewColumn Header="유형" Width="44">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <ui:ProductIcon FilePath="{Binding FullPath}" Width="18" Height="18" Margin="6,0" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="파일명" Width="300">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <ItemsControl Margin="6,0" VerticalAlignment="Center" ClipToBounds="True"
                                ItemsSource="{Binding FileNameSegments}"
                                ItemTemplate="{StaticResource HighlightedTextTemplate}"
                                ToolTip="{Binding FullPath}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="경로" Width="380">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <ItemsControl Margin="6,0" VerticalAlignment="Center" ClipToBounds="True"
                                Opacity="0.72" ItemsSource="{Binding PathSegments}"
                                ItemTemplate="{StaticResource HighlightedTextTemplate}"
                                ToolTip="{Binding FullPath}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="프로젝트" Width="150">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Margin="6,0" VerticalAlignment="Center" Opacity="0.78"
                             FontSize="11" Text="{Binding ProjectName}"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectName}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ui:FittedResultsList>

      <StackPanel x:Name="EmptyStatePanel"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False">
        <TextBlock x:Name="EmptyStateTitle"
                   HorizontalAlignment="Center"
                   FontSize="15"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="EmptyStateDescription"
                   Margin="0,5,0,0"
                   HorizontalAlignment="Center"
                   Opacity="0.68" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="2"
            Margin="-12,0,-12,-12"
            Padding="12,7,12,8"
            Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarOptionsBackgroundKey}}"
            BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
            BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="True">
        <Button Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" x:Name="CancelSearchButton"
                DockPanel.Dock="Right"
                Margin="12,-3,0,-3"
                Padding="9,2"
                Content="검색 취소"
                Visibility="Collapsed"
                Click="OnCancelSearchClick" />
        <TextBlock x:Name="KeyboardHintText"
                   DockPanel.Dock="Right"
                   Margin="14,0,0,0"
                   Opacity="0.72"
                   Text="↑↓ 선택   Enter 열기   Esc 닫기" />
        <TextBlock x:Name="StatusText" Opacity="0.78" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</platform:DialogWindow>
